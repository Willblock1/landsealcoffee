{% assign coffee_collection = section.settings.coffee_collection %}
{% if coffee_collection == blank %}
  {% assign coffee_collection = collections.all %}
{% endif %}
{% assign available_products = coffee_collection.products | where: 'available', true %}
{% assign featured_product = section.settings.featured_product %}
{% if featured_product == blank %}
  {% assign featured_product = available_products.first %}
{% elsif featured_product.available == false %}
  {% assign featured_product = available_products.first %}
{% endif %}
{% assign featured_best_for = section.settings.best_for %}
{% if featured_product != blank %}
  {% assign featured_tags = featured_product.tags | join: ',' | downcase %}
  {% assign featured_title = featured_product.title | downcase %}
  {% if featured_tags contains 'espresso' %}
    {% assign featured_best_for = 'Espresso' %}
  {% elsif featured_title contains 'ethiopia' or featured_title contains 'kenya' %}
    {% assign featured_best_for = 'Drip · Pour-over' %}
  {% endif %}
{% endif %}
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">SMALL-BATCH · WHOLE BEAN</p>
    <h1>Good coffee.<br><em>No fuss.</em></h1>
    <p class="intro">Thoughtfully sourced beans, roasted fresh in Indianapolis, and shipped when they're ready—not when they've been sitting on a shelf.</p>
    <a class="primary-link" href="#coffee">See what's in stock <span>↓</span></a>
    <div class="freshness"><i></i> Roasted in small batches</div>
  </div>
  <div class="hero-visual">
    <div class="sun"></div>
    <img class="hero-logo" src="{{ 'land-seal-logo.png' | asset_url }}" alt="" width="520" height="520">
    <div class="wave-lines" aria-hidden="true"><i></i><i></i><i></i></div>
    <p>FROM THE BAY<br>TO THE CROSSROADS</p>
  </div>
</section>

<section class="marquee" aria-label="Coffee qualities">
  <span>WHOLE BEAN</span><b>✦</b><span>ROASTED FRESH</span><b>✦</b><span>SMALL BATCH</span><b>✦</b><span>INDIANAPOLIS</span>
</section>

<section class="product-section" id="coffee">
  <div class="section-heading">
    <div><p class="eyebrow">ROASTING NOW</p><h2>What's in stock</h2></div>
    <p>Choose from every coffee currently in stock. This list updates automatically as products become available or sell out in Shopify.</p>
  </div>
  <article class="product-card">
    <div class="roast-guide inventory-guide">
      <p class="eyebrow">ORIGINS AVAILABLE NOW</p>
      <h3>Pick your<br><em>coffee.</em></h3>
      {% if available_products.size > 0 %}
        <p class="inventory-summary">{{ available_products.size }} fresh {% if available_products.size == 1 %}roast{% else %}roasts{% endif %} ready to order. Select an origin to see its full details.</p>
        <nav class="inventory-list" aria-label="Available coffee origins">
          {% for coffee_product in available_products %}
            {% assign brew_method = '' %}
            {% assign coffee_tags = coffee_product.tags | join: ',' | downcase %}
            {% assign coffee_title = coffee_product.title | downcase %}
            {% if coffee_tags contains 'espresso' %}
              {% assign brew_method = 'Best for espresso' %}
            {% elsif coffee_title contains 'ethiopia' or coffee_title contains 'kenya' %}
              {% assign brew_method = 'Best for drip' %}
            {% endif %}
            <a class="inventory-card{% if featured_product.id == coffee_product.id %} inventory-card--featured{% endif %}" href="{{ coffee_product.url }}">
              <span class="inventory-card__media">
                {% if coffee_product.featured_image %}
                  {% assign card_image_alt = coffee_product.featured_image.alt | default: coffee_product.title %}
                  {{ coffee_product.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: card_image_alt }}
                {% else %}
                  <span aria-hidden="true">☕</span>
                {% endif %}
              </span>
              <span class="inventory-card__content">
                <span class="inventory-card__status"><i></i> In stock</span>
                <strong>{{ coffee_product.title | escape }}</strong>
                {% if brew_method != blank %}<small>{{ brew_method }}</small>{% endif %}
                <small>{{ coffee_product.price | money }}</small>
              </span>
              <span class="inventory-card__arrow" aria-hidden="true">→</span>
            </a>
          {% endfor %}
        </nav>
      {% else %}
        <p class="inventory-summary">The next small-batch release is being prepared. Check back soon for new origins.</p>
      {% endif %}
    </div>
    <div class="product-info">
      {% if featured_product != blank %}
        <p class="eyebrow">WHOLE BEAN · ROASTED TO ORDER</p>
        <h3>{{ featured_product.title | escape }}</h3>
        <p class="price">{{ featured_product.selected_or_first_available_variant.price | money }}</p>
        <div class="description">{{ featured_product.description | strip_html | truncatewords: 42 }}</div>
        <div class="details">
          <div><span>ROAST</span><strong>{{ section.settings.roast_level | escape }}</strong></div>
          <div><span>BEST FOR</span><strong>{{ featured_best_for | escape }}</strong></div>
          <div><span>FORMAT</span><strong>Whole bean only</strong></div>
        </div>
        {% form 'product', featured_product, class: 'product-form' %}
          {% if featured_product.has_only_default_variant %}
            <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">
          {% else %}
            <label>Choose an option
              <select name="id">
                {% for variant in featured_product.variants %}
                  <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title | escape }} · {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </label>
          {% endif %}
          <label>Quantity
            <select name="quantity">
              <option value="1">1 bag</option><option value="2">2 bags</option><option value="3">3 bags</option><option value="4">4 bags</option>
            </select>
          </label>
          <button class="add-button" type="submit" {% unless featured_product.available %}disabled{% endunless %}>
            {% if featured_product.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
        {% endform %}
        <p class="shipping-note">Roasted to order · Ships in 2–3 business days</p>
      {% else %}
        <p class="eyebrow">THE NEXT ROAST</p>
        <h3>Fresh coffee is on the way</h3>
        <p class="description">We're preparing the next small-batch release. Check back soon for origin details and availability.</p>
      {% endif %}
    </div>
  </article>
</section>

{% capture upcoming_cards %}
  {% for block in section.blocks %}
    {% if block.type == 'upcoming_coffee' and block.settings.enabled %}
      {% assign upcoming_product = all_products[block.settings.product_handle] %}
      {% if upcoming_product == blank %}
        <article class="coming-coffee" {{ block.shopify_attributes }}>
          <p class="coming-coffee__badge">{{ 'storefront.upcoming.badge' | t }}</p>
          <h3>{{ block.settings.title | escape }}</h3>
          <p class="coming-coffee__notes">{{ block.settings.notes | escape }}</p>
          <p class="coming-coffee__brew">{{ block.settings.brew_method | escape }}</p>
          <p class="coming-coffee__price">{{ block.settings.price_cents | money }} <span>· {{ 'storefront.upcoming.format' | t }}</span></p>
        </article>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign upcoming_cards = upcoming_cards | strip %}
{% if upcoming_cards != blank %}
  <section class="coming-section" aria-labelledby="coming-heading">
    <div class="section-heading">
      <div><p class="eyebrow">{{ 'storefront.upcoming.eyebrow' | t }}</p><h2 id="coming-heading">{{ 'storefront.upcoming.heading' | t }}</h2></div>
      <p>{{ 'storefront.upcoming.description' | t }}</p>
    </div>
    <div class="coming-grid">{{ upcoming_cards }}</div>
  </section>
{% endif %}

{% stylesheet %}
.coming-section{padding:0 8vw 7rem}.coming-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1.2rem}.coming-coffee{padding:1.6rem;background:var(--white);border:1.5px solid rgba(24,50,74,.2);border-radius:10px;display:flex;flex-direction:column}.coming-coffee__badge{align-self:flex-start;padding:.35rem .65rem;background:var(--paper);color:var(--ink);border-radius:20px;font-size:.72rem;font-weight:800;margin:0 0 1.1rem}.coming-coffee h3{font-family:'Fraunces',serif;font-size:1.55rem;line-height:1.2;margin:0 0 .8rem}.coming-coffee__notes{line-height:1.65;color:#506274;margin:0 0 1rem}.coming-coffee__brew{font-size:.82rem;font-weight:700;color:var(--blue);margin:auto 0 0}.coming-coffee__price{font-size:1.15rem;font-weight:800;margin:1rem 0 0}.coming-coffee__price span{font-size:.75rem;font-weight:500}@media(max-width:800px){.coming-section{padding:0 1rem 4rem}}
{% endstylesheet %}

<section class="story" id="story">
  <div class="story-mark"><img src="{{ 'land-seal-logo.png' | asset_url }}" alt="" width="500" height="500"></div>
  <div class="story-copy">
    <p class="eyebrow">OUR STORY</p>
    <h2>It started with a<br>popcorn popper.</h2>
    <p>I've always loved coffee, but by 2021 I was growing tired of what I could find at Starbucks and the grocery store. With two weeks between jobs, I had an idea: roast my own.</p>
    <p>I did a little research, bought a popcorn popper, and started roasting on the stove in our one-bedroom apartment. I wouldn't recommend that approach—the smell took over, and I came a little too close to burning down the building more than once.</p>
    <p>I've since upgraded to a proper roaster and a dedicated setup in my garage. Pour-over is still how I most often drink coffee, though I've spent plenty of time mastering espresso for my wife and friends.</p>
    <div class="name-origin">
      <span>WHY LAND SEAL?</span>
      <p>While we were living in San Francisco, we often saw seals in the bay—and couldn't help noticing how much they looked like our dog, Finn, a pitty mix. Now that we're in Indiana, the name honors our sea-dog friends back in the bay through our own dog: the land seal.</p>
    </div>
    <div class="freshness-principle">
      <span>WHAT FIVE YEARS OF ROASTING TAUGHT ME</span>
      <strong>Great coffee comes down to quality beans and a fresh roast.</strong>
    </div>
    <p>Like bread, coffee gets stale. That's why I roast only after you place your order—so you can experience it at its freshest.</p>
  </div>
</section>

<section class="faq" id="faq">
  <p class="eyebrow">GOOD TO KNOW</p><h2>Before you brew</h2>
  <details open><summary>Do you sell ground coffee?</summary><p>No—Land Seal coffee is sold as whole bean only, so it stays fresh until you're ready to grind and brew it.</p></details>
  <details><summary>When is the coffee roasted?</summary><p>Every order goes into the roasting queue after purchase. We roast in small batches, then pack and ship within 2–3 business days.</p></details>
  <details><summary>How should I store the beans?</summary><p>Keep the bag sealed in a cool, dry cupboard. Skip the fridge and grind only what you need before brewing.</p></details>
</section>

{% schema %}
{
  "name": "Land Seal storefront",
  "settings": [
    {
      "type": "collection",
      "id": "coffee_collection",
      "label": "Available coffee collection"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured coffee (optional)"
    },
    {
      "type": "text",
      "id": "roast_level",
      "label": "Roast level",
      "default": "Medium"
    },
    {
      "type": "text",
      "id": "best_for",
      "label": "Best for",
      "default": "Drip \u00b7 Pour-over"
    }
  ],
  "presets": [
    {
      "name": "Land Seal storefront"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "upcoming_coffee",
      "name": "Coming soon coffee",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show preview",
          "default": true
        },
        {
          "type": "text",
          "id": "product_handle",
          "label": "Shopify product handle",
          "info": "Preview hides when this product is published to the Online Store."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Coffee name"
        },
        {
          "type": "textarea",
          "id": "notes",
          "label": "Tasting notes"
        },
        {
          "type": "text",
          "id": "brew_method",
          "label": "Brewing method"
        },
        {
          "type": "number",
          "id": "price_cents",
          "label": "Price in cents (USD)",
          "default": 2400
        }
      ]
    }
  ]
}
{% endschema %}
