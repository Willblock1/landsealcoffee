<section class="cart-page">
  <p class="eyebrow">YOUR ORDER</p>
  <h1>Your cart</h1>
  {% if cart.empty? %}
    <div class="cart-empty"><p>Your cart is still waiting for coffee.</p><a class="primary-link" href="{{ routes.root_url }}#coffee">Shop coffee</a></div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-lines">
        {% for item in cart.items %}
          <article class="cart-line">
            <a href="{{ item.url }}">
              {% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.title }}{% else %}<img src="{{ 'land-seal-logo.png' | asset_url }}" alt="" width="90" height="90">{% endif %}
            </a>
            <div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<a class="remove-link" href="{{ item.url_to_remove }}">Remove</a></div>
            <label>Quantity<input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label>
            <strong>{{ item.final_line_price | money }}</strong>
          </article>
        {% endfor %}
      </div>
      <div class="cart-summary">
        <div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
        <p>Shipping and taxes calculated at checkout.</p>
        <button class="secondary-button" type="submit" name="update">Update cart</button>
        <button class="checkout-button" type="submit" name="checkout">Checkout</button>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{"name":"Cart","settings":[]}
{% endschema %}
