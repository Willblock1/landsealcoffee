{% if section.settings.announcement != blank %}
  <div class="announcement">{{ section.settings.announcement | escape }}</div>
{% endif %}
<header class="site-header">
  <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
    <img src="{{ 'land-seal-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="58" height="58">
    <span>LAND SEAL</span>
  </a>
  <nav aria-label="Main navigation">
    <a href="{{ routes.root_url }}#coffee">Coffee</a>
    <a href="{{ routes.root_url }}#story">Our story</a>
    <a href="{{ routes.root_url }}#faq">FAQ</a>
  </nav>
  <a class="cart-button" href="{{ routes.cart_url }}">Cart <span data-cart-count>{{ cart.item_count }}</span></a>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Free local delivery in Indianapolis on orders over $35"
    }
  ]
}
{% endschema %}
